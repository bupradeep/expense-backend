PORT=3000

# --- SQL Server ---------------------------------------------------------
DB_USER=sa
DB_PASSWORD=YourPassword
DB_SERVER=localhost
DB_DATABASE=ExpenseReimbursement
DB_PORT=1433

# For a SQL Server Express named instance, use this instead of DB_SERVER/DB_PORT above:
# DB_SERVER=localhost\\SQLEXPRESS
# DB_PORT=

DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT=30000

# --- Mail (see "Email notifications" in README.md) ----------------------
# ethereal = sandbox test provider, nothing reaches a real inbox (default, safe for local dev)
# smtp     = real delivery via any SMTP server/relay (Office365, Gmail, SendGrid, Mailgun, SES, ...)
MAIL_PROVIDER=ethereal
MAIL_FROM=Expense Reimbursement <no-reply@example.com>

# Required when MAIL_PROVIDER=smtp:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Azure AD (Entra ID) -------------------------------------------------
# Used by middleware/authMiddleware.js to validate incoming API bearer tokens (signature via
# JWKS, issuer, audience, expiry). Every route except GET /health requires a valid token from
# this tenant/app registration -- see "Authentication" in README.md.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- Microsoft Graph (SharePoint receipt storage) -------------------------
# Optional: only required if you want expense receipt files uploaded to SharePoint (see
# "Receipt storage" in README.md). Uses the same AZURE_CLIENT_ID app registration above, but
# additionally needs a client secret and the Sites.ReadWrite.All (or Files.ReadWrite.All)
# *application* permission, admin-consented.
AZURE_CLIENT_SECRET=

# The SharePoint site that hosts the receipts document library, e.g.:
# GET https://graph.microsoft.com/v1.0/sites/{hostname}:/sites/{site-path}
SHAREPOINT_SITE_ID=

# Display name of the document library receipts are uploaded into.
SHAREPOINT_RECEIPTS_LIBRARY_NAME=ExpenseReceipt

# Optional: pin uploads to a specific drive id instead of resolving the library above by name.
SHAREPOINT_RECEIPTS_DRIVE_ID=
