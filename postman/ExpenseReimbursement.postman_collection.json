{
  "info": {
    "name": "Expense Reimbursement API",
    "description": "CRUD and workflow APIs for the Expense Reimbursement backend (Express + Sequelize).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userId", "value": "1" },
    { "key": "approverId", "value": "2" },
    { "key": "employeeId", "value": "1" },
    { "key": "departmentId", "value": "1" },
    { "key": "projectId", "value": "1" },
    { "key": "categoryId", "value": "1" },
    { "key": "policyRuleId", "value": "1" },
    { "key": "approvalRuleId", "value": "1" },
    { "key": "expenseClaimId", "value": "1" },
    { "key": "expenseItemId", "value": "1" },
    { "key": "receiptId", "value": "1" },
    { "key": "reimbursementId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Create Expense",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/expenses", "host": ["{{baseUrl}}"], "path": ["expenses"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"claimNumber\": \"EXP-2001\",\n  \"employeeId\": {{employeeId}},\n  \"departmentId\": {{departmentId}},\n  \"projectId\": {{projectId}},\n  \"claimDate\": \"2026-09-18\",\n  \"businessPurpose\": \"Client meeting\",\n  \"location\": \"Bangalore\",\n  \"paymentMethod\": \"Credit Card\",\n  \"remarks\": \"Client visit\",\n  \"createdBy\": {{userId}},\n  \"items\": [\n    {\n      \"categoryId\": {{categoryId}},\n      \"expenseDate\": \"2026-09-18\",\n      \"amount\": 4500,\n      \"merchantName\": \"ABC Hotel\",\n      \"description\": \"Hotel stay\",\n      \"businessPurpose\": \"Client meeting\",\n      \"paymentMethod\": \"Credit Card\"\n    },\n    {\n      \"categoryId\": {{categoryId}},\n      \"expenseDate\": \"2026-09-18\",\n      \"amount\": 800,\n      \"merchantName\": \"XYZ Restaurant\",\n      \"description\": \"Dinner\",\n      \"businessPurpose\": \"Client meeting\",\n      \"paymentMethod\": \"Credit Card\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "List Expenses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/expenses?employeeId={{employeeId}}&status=Draft&departmentId={{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["expenses"],
              "query": [
                { "key": "employeeId", "value": "{{employeeId}}" },
                { "key": "status", "value": "Draft" },
                { "key": "departmentId", "value": "{{departmentId}}" }
              ]
            }
          }
        },
        {
          "name": "Get Expense By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/expenses/{{expenseClaimId}}", "host": ["{{baseUrl}}"], "path": ["expenses", "{{expenseClaimId}}"] }
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/expenses/{{expenseClaimId}}", "host": ["{{baseUrl}}"], "path": ["expenses", "{{expenseClaimId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessPurpose\": \"Client meeting - updated\",\n  \"location\": \"Bangalore\",\n  \"paymentMethod\": \"Credit Card\",\n  \"remarks\": \"Updated remarks\",\n  \"updatedBy\": {{userId}},\n  \"items\": [\n    {\n      \"categoryId\": {{categoryId}},\n      \"expenseDate\": \"2026-09-18\",\n      \"amount\": 5000,\n      \"merchantName\": \"ABC Hotel\",\n      \"description\": \"Hotel stay\",\n      \"businessPurpose\": \"Client meeting\",\n      \"paymentMethod\": \"Credit Card\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/expenses/{{expenseClaimId}}", "host": ["{{baseUrl}}"], "path": ["expenses", "{{expenseClaimId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"updatedBy\": {{userId}}\n}"
            }
          }
        },
        {
          "name": "Submit Expense",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/expenses/{{expenseClaimId}}/submit", "host": ["{{baseUrl}}"], "path": ["expenses", "{{expenseClaimId}}", "submit"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}}\n}"
            }
          }
        },
        {
          "name": "Get Expense History",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/expenses/{{expenseClaimId}}/history", "host": ["{{baseUrl}}"], "path": ["expenses", "{{expenseClaimId}}", "history"] }
          }
        },
        {
          "name": "Get Expense Receipts",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/expenses/{{expenseClaimId}}/receipts", "host": ["{{baseUrl}}"], "path": ["expenses", "{{expenseClaimId}}", "receipts"] }
          }
        }
      ]
    },
    {
      "name": "Approvals",
      "item": [
        {
          "name": "Get Pending Approvals",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/approvals/pending?userId={{approverId}}",
              "host": ["{{baseUrl}}"],
              "path": ["approvals", "pending"],
              "query": [{ "key": "userId", "value": "{{approverId}}" }]
            }
          }
        },
        {
          "name": "Get Approval History (filtered)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/approvals/history?fromDate=2026-01-01&toDate=2026-12-31&status=Approved&approverId={{approverId}}&expenseClaimId={{expenseClaimId}}",
              "host": ["{{baseUrl}}"],
              "path": ["approvals", "history"],
              "query": [
                { "key": "fromDate", "value": "2026-01-01" },
                { "key": "toDate", "value": "2026-12-31" },
                { "key": "status", "value": "Approved" },
                { "key": "approverId", "value": "{{approverId}}" },
                { "key": "expenseClaimId", "value": "{{expenseClaimId}}" }
              ]
            }
          }
        },
        {
          "name": "Approve Expense",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/approvals/{{expenseClaimId}}/approve", "host": ["{{baseUrl}}"], "path": ["approvals", "{{expenseClaimId}}", "approve"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approverId\": {{approverId}},\n  \"approvalLevel\": 1,\n  \"comments\": \"Approved\"\n}"
            }
          }
        },
        {
          "name": "Reject Expense",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/approvals/{{expenseClaimId}}/reject", "host": ["{{baseUrl}}"], "path": ["approvals", "{{expenseClaimId}}", "reject"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approverId\": {{approverId}},\n  \"approvalLevel\": 1,\n  \"comments\": \"Receipt is missing\"\n}"
            }
          }
        },
        {
          "name": "Send Back Expense",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/approvals/{{expenseClaimId}}/send-back", "host": ["{{baseUrl}}"], "path": ["approvals", "{{expenseClaimId}}", "send-back"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approverId\": {{approverId}},\n  \"approvalLevel\": 1,\n  \"comments\": \"Please provide the invoice\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Reimbursement (Payment)",
      "item": [
        {
          "name": "Process Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/expenses/{{expenseClaimId}}/payment", "host": ["{{baseUrl}}"], "path": ["expenses", "{{expenseClaimId}}", "payment"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"processedBy\": {{userId}},\n  \"paymentReference\": \"PAY-2001\",\n  \"paymentDate\": \"2026-09-20\",\n  \"paymentAmount\": 5300,\n  \"paymentMethod\": \"Bank Transfer\",\n  \"transactionReference\": \"TXN-12345\",\n  \"paymentRemarks\": \"Payment completed\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
